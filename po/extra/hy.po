#: data/videos.metainfo.xml.in:10 data/io.elementary.videos.desktop.in:4
msgid "Videos"
msgstr "Videos"

#: data/videos.metainfo.xml.in:11 data/io.elementary.videos.desktop.in:6
msgid "Watch videos and movies"
msgstr "Դիտեք տեսանյութեր և ֆիլմեր"

#: data/videos.metainfo.xml.in:13
msgid ""
"A modern video player that focuses on displaying video content instead of "
"player controls. It remembers your last played video and playback position "
"so you can pick up from where you left off."
msgstr ""
"Ժամանակակից տեսանյութերի նվագարկիչ, որը կենտրոնանում է տեսանյութի ցուցադրման "
"վրա՝ նվագարկման կառավարման տարրերի փոխարեն։ Այն հիշում է ձեր վերջին "
"նվագարկված տեսանյութը և նվագարկման դիրքը, որպեսզի կարողանաք շարունակել "
"այնտեղից, որտեղ կանգ եք առել։"

#: data/videos.metainfo.xml.in:14
msgid "Additional features include:"
msgstr "Լրացուցիչ հնարավորություններ՝"

#: data/videos.metainfo.xml.in:16
msgid "Subtitle support"
msgstr "Ենթագրերի աջակցություն"

#: data/videos.metainfo.xml.in:17
msgid "Play queue"
msgstr "Նվագարկման հերթ"

#: data/videos.metainfo.xml.in:18
msgid "Thumbnail previews on the seek bar"
msgstr "Մանրապատկերների նախադիտում նվագարկման գծի վրա"

#: data/videos.metainfo.xml.in:51
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/videos.metainfo.xml.in:59 data/videos.metainfo.xml.in:79
#: data/videos.metainfo.xml.in:96
msgid "Improvements:"
msgstr "Բարելավումներ՝"

#: data/videos.metainfo.xml.in:61
msgid "Open the main menu with the keyboard shortcut F10"
msgstr "Գլխավոր ցանկը բացվում է F10 ստեղնաշարային դյուրանցմամբ"

#: data/videos.metainfo.xml.in:62
msgid "Use the File Chooser Portal"
msgstr "Օգտագործվում է File Chooser Portal-ը"

#: data/videos.metainfo.xml.in:63 data/videos.metainfo.xml.in:85
#: data/videos.metainfo.xml.in:101 data/videos.metainfo.xml.in:113
#: data/videos.metainfo.xml.in:127 data/videos.metainfo.xml.in:137
msgid "Translation updates"
msgstr "Թարմացված թարգմանություններ"

#: data/videos.metainfo.xml.in:70
msgid ""
"Small hotfix release that fixes an annoying issue causing videos to play in "
"a second window."
msgstr ""
"Փոքր շտկման թողարկում, որը վերացնում է նյարդայնացնող խնդիրը, երբ "
"տեսանյութերը նվագարկվում էին երկրորդ պատուհանում։"

#: data/videos.metainfo.xml.in:81
msgid "Respect dark style preference"
msgstr "Հաշվի է առնվել մուգ ոճի նախապատվությունը"

#: data/videos.metainfo.xml.in:82
msgid "Support repeat one and repeat all"
msgstr "Ավելացվել է մեկի և բոլորի կրկնման աջակցություն"

#: data/videos.metainfo.xml.in:83
msgid "Performance improvements"
msgstr "Արտադրողականության բարելավումներ"

#: data/videos.metainfo.xml.in:84
msgid "Drop support for optical media"
msgstr "Հեռացվել է օպտիկական կրիչների աջակցությունը"

#: data/videos.metainfo.xml.in:98
msgid "Updated flatter design"
msgstr "Թարմացվել է ավելի հարթ դիզայնը"

#: data/videos.metainfo.xml.in:99
msgid "Send an app notification when adding items to the play queue"
msgstr "Նվագարկման հերթում տարրեր ավելացնելիս ուղարկվում է հավելվածի ծանուցում"

#: data/videos.metainfo.xml.in:100
msgid "More accurate playback position save and restore"
msgstr "Նվագարկման դիրքի ավելի ճշգրիտ պահպանում և վերականգնում"

#: data/videos.metainfo.xml.in:111 data/videos.metainfo.xml.in:124
#: data/videos.metainfo.xml.in:134
msgid "Other updates:"
msgstr "Այլ թարմացումներ՝"

#: data/videos.metainfo.xml.in:120
msgid "New features:"
msgstr "Նոր հնարավորություններ՝"

#: data/videos.metainfo.xml.in:122
msgid "Control playback from the sound indicator"
msgstr "Նվագարկման կառավարում ձայնի ինդիկատորից"

#: data/videos.metainfo.xml.in:126
msgid "Make playback duration more accurate"
msgstr "Նվագարկման տևողությունը դարձել է ավելի ճշգրիտ"

#: data/videos.metainfo.xml.in:136
msgid "Update to Flatpak Platform 7"
msgstr "Թարմացվել է Flatpak Platform 7-ին"

#: data/io.elementary.videos.desktop.in:5
msgid "Video Player"
msgstr "Տեսանյութերի նվագարկիչ"
